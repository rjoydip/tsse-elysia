{
  "name": "tsse-elysia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun run script:setup",
    "cleanup": "bun run script:cleanup",
    "postinstall": "bunx playwright install",
    "prepare": "simple-git-hooks",
    "build": "bun --bun vite build",
    "dev": "bun --bun vite dev",
    "start": "node ./dist/server/server.js",
    "preview": "bun --bun vite preview",
    "frameless:preview": "bunx broz http://localhost:3000",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --format=github",
    "lint:ci": "bun run format:check && bun run lint",
    "lint:check": "bun run format:check && bun run lint && bun run fallow:dead && bun run actions-up",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "test": "bun test --preload ./test/setup.ts",
    "proxy:start": "bun --run portless proxy start --https",
    "proxy:foreground": "bun --run portless proxy start --foreground",
    "proxy:stop": "bun --run portless proxy stop --https",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "bun playwright test --ui",
    "test:e2e:headed": "bun playwright test --headed",
    "test:e2e:report": "bun playwright show-report",
    "test:load": "bunx k6 run .k6/smoke-test.js",
    "test:load:api": "bunx k6 run .k6/api-test.js",
    "test:load:stress": "bunx k6 run .k6/stress-test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run ./scripts/db-seed.ts",
    "db:seed:fresh": "bun run db:seed --fresh",
    "db:seed:prod": "bun run db:seed --prod",
    "db:remove": "bun run ./scripts/remove-db.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "db:reset": "bun run db:remove && bun run db:migrate",
    "security": "bun audit --audit-level=critical",
    "routes:generate": "tsr generate",
    "typecheck": "tsc --noEmit",
    "react:doctor": "react-doctor . -y",
    "actions-up": "actions-up",
    "version": "changelogen --bump",
    "changelog": "changelogen",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --format badge > .artifacts/fallow-badge.svg",
    "fallow:fix": "fallow fix --dry-run",
    "script:setup": "bun run ./scripts/setup.ts",
    "script:cleanup": "bun run ./scripts/cleanup.ts",
    "script:patch:server": "bun run ./scripts/patch-server.ts",
    "script:decision:new": "bun scripts/new-decision.ts",
    "script:check-db": "bun run ./scripts/check-db.ts",
    "script:fix-migrations": "bun run ./scripts/fix-migrations.ts",
    "script:opencode-session-clear": "bun run ./scripts/opencode-session-clear.ts",
    "script:release": "bun run ./scripts/release.ts",
    "script:sync-tasks": "bun run ./scripts/sync-tasks.ts",
    "script:task-config": "bun run ./scripts/task-config.ts",
    "script:generate-bruno": "bun run ./scripts/generate-bruno-collections.ts",
    "bruno:seed": "PGLITE_DATA_DIR=.artifacts/pglite-data-bruno bun run db:seed --fresh --prod",
    "bruno:server": "PGLITE_DATA_DIR=.artifacts/pglite-data-bruno BASE_URL=http://localhost:4174 BETTER_AUTH_URL=http://localhost:4174/api/auth bun run preview --port 4174",
    "bruno:cleanup": "PGLITE_DATA_DIR=.artifacts/pglite-data-bruno bun run db:remove",
    "bruno:ci": "cd .bruno/collections && npx @usebruno/cli run . --env-file ../environments/ci.yml --tags smoke -r",
    "bruno:smoke": "cd .bruno/collections && npx @usebruno/cli run . --env-file ../environments/local.yml --tags smoke -r",
    "bruno:run": "cd .bruno/collections && npx @usebruno/cli run . --env-file ../environments/local.yml -r",
    "email:dev": "maizzle serve",
    "email:build": "maizzle build",
    "email:new:template": "maizzle make:template",
    "email:new:layout": "maizzle make:layout"
  },
  "dependencies": {
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@modelcontextprotocol/node": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@neondatabase/serverless": "^1.1.0",
