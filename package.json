    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-direction": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@scrambl/react": "^0.1.1",
    "@shikijs/core": "^4.2.0",
    "@shikijs/engine-javascript": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tanstack/router-cli": "1.167.17",
    "a11yer": "^0.1.0",
    "better-auth": "^1.6.19",
    "better-result": "^2.9.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "db0": "^0.3.4",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "elysia-rate-limit": "^4.6.2",
    "evlog": "^2.19.1",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.20.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-day-picker": "9.14.0",
    "react-markdown": "^10.1.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "uncrypto": "^0.1.3",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@faker-js/faker": "^10.4.0",
    "@maizzle/framework": "^6.0.1",
    "@playwright/test": "^1.61.0",
    "@rsbuild/core": "^2.0.15",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@usebruno/cli": "^3.4.2",
    "@usebruno/converters": "^0.20.0",
    "@vitejs/plugin-react": "^6.0.2",
    "actions-up": "^1.14.3",
    "broz": "^1.0.1",
    "bun-types": "^1.3.14",
    "changelogen": "^0.6.2",
    "comptime": "^0.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "fallow": "^2.97.0",
    "fdir": "^6.5.0",
    "k6": "^0.0.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "portless": "^0.14.0",
    "react-doctor": "^0.5.6",
    "react-dom": "^19.2.7",
    "simple-git-hooks": "^2.13.1",
    "std-env": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint:check && bun run typecheck && bun run react:doctor && bun run actions-up && bun run db:generate"
  },
  "reactDoctor": {
    "lint": false,
    "ignore": {
      "files": [
        "~/.bun-install-cache/**/*",
        ".e2e/**/*",
        ".opencode/**/*",
        "load-tests/**/*",
        "test/**/*",
        "*.config.ts",
        "k6.config.js"
      ]
    }
  }
}