# Authentication
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_AUTH_GITHUB_ENABLED=true
VITE_AUTH_GOOGLE_ENABLED=true

# Server Configuration
NODE_ENV=your-environment
HOST=localhost
PORT=3000
PROTOCAL=http
BASE_URL=http://localhost:3000

# Client Configuration
VITE_API_URL=http://localhost:3000/api
VITE_PASS_ENCRYPTION_KEY=default-pass-key-replace-me-in-prod
VITE_BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Database Configuration
# Primary database: PGlite (in-process WASM PostgreSQL)
# Data is persisted to the directory below by default
PGLITE_DATA_DIR=.artifacts/pglite-data

# Alternative: PostgreSQL (production)
# Option 1: Full connection URL (recommended)
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://tsse:password@localhost:5432/tsse_dev
POSTGRES_REPLICAS=["postgresql://tsse:password@localhost:5433/tsse_dev","postgresql://tsse:password@localhost:5434/tsse_dev"]

# Option 2: Individual connection parameters (used when POSTGRES_URL is not set)
POSTGRES_USER=tsse
POSTGRES_PASSWORD=tsse_password
POSTGRES_DB=tsse_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Neon / Cloudflare Hyperdrive (serverless PG alternatives)
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/db
# CF_HYPERDRIVE_BINDING=your-hyperdrive-binding

# Redis Configuration
# Local Docker: redis://localhost:6379
# Upstash:      rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379

# WebSocket Configuration
# WS_ENABLED=true
# WS_HEARTBEAT_INTERVAL=30000
# WS_MAX_MESSAGE_SIZE=1048576
# WS_RATE_LIMIT_MESSAGES=100
# WS_RATE_LIMIT_WINDOW=60000

# Feature Flags
# FEATURE_MULTI_TEAM=false

# Evlog (Structured Logging)
# EVLOG_DIR=.evlog/logs
# EVLOG_ADAPTER=fs         # Options: fs, otlp
# EVLOG_LOG_LEVEL=info     # Options: debug, info, warn, error

# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
