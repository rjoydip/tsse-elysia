# Authentication
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_AUTH_GITHUB_ENABLED=true
VITE_AUTH_GOOGLE_ENABLED=true

# Server Configuration
NODE_ENV=your-environment
HOST=localhost
PORT=3000
PROTOCAL=http
BASE_URL=http://localhost:3000

# Client Configuration
VITE_API_URL=http://localhost:3000/api
VITE_BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api
BETTER_AUTH_URL=http://localhost:3000/api/auth

# Database Configuration
DATABASE_TYPE=sqlite  # Options: sqlite, postgres

# SQLite Configuration (LibSQL)
# File-based: SQLITE_URL=file:./path/to/your.db
# Turso:     SQLITE_URL=libsql://your-database.turso.io
# In-memory: SQLITE_URL=:memory:
SQLITE_URL=file:.artifacts/tsse-elysia.db
SQLITE_AUTH_TOKEN=  # For Turso remote databases

# PostgreSQL Configuration
# Option 1: Full connection URL (recommended for production/replicas)
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://tsse:password@localhost:5432/tsse_dev
POSTGRES_REPLICAS=["postgresql://tsse:password@localhost:5433/tsse_dev","postgresql://tsse:password@localhost:5434/tsse_dev"]

# Option 2: Individual connection parameters (used when POSTGRES_URL is not set)
# These are used as fallback to build the primary connection string
POSTGRES_USER=tsse
POSTGRES_PASSWORD=tsse_password
POSTGRES_DB=tsse_dev
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Redis Configuration
# Local Docker: redis://localhost:6379
# Upstash:      rediss://default:TOKEN@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6379
